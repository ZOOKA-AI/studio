# Supabase Environment Variables
# Get these values from: https://supabase.com/dashboard/project/bylfizytgayoefuyliix/settings/api

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://bylfizytgayoefuyliix.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Keep this secret! Only use on server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: For local development with Supabase CLI
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Firebase Configuration (if still using Firebase)
